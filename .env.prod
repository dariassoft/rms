# ==========================================
#  — Variables de Producción
# ==========================================
# ⚠️  COPIAR este archivo como .env en el servidor de producción
# ⚠️  CAMBIAR todos los valores marcados como <CAMBIAR_EN_PRODUCCIÓN>
# ==========================================

# ==========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==========================================
NODE_ENV=production
APP_PORT=3000
APP_NAME="_API"

# URLs Públicas (Cambiar por tu dominio real)
DOMAIN=rms.dariassoft.com.ar
APP_URL="https://api.${DOMAIN}"
FRONTEND_URL="https://${DOMAIN}"

# ==========================================
# BASE DE DATOS (MySQL)
# ==========================================
DB_TYPE=mysql
DB_HOST=db             # Nombre del servicio en docker-compose.prod.yml
DB_PORT=3306
DB_USER=dev_user
DB_PASSWORD=dev_password
DB_NAME=RMS_db
DB_ROOT_PASSWORD=dev_root_password
DB_SYNCHRONIZE=true   # Cambiado a true para desarrollo inicial en producción
DB_LOGGING=false
DB_RUN_MIGRATIONS=false # Desactivado por ahora ya que no hay archivos de migración
DB_RUN_SEED=true      # Cargar datos iniciales (poner en true al primer despliegue)

# ==========================================
# SEGURIDAD Y AUTENTICACIÓN
# ==========================================
# Generar con: openssl rand -base64 64
JWT_SECRET=<JWT_SECRET_LARGO_Y_ALEATORIO>
JWT_EXPIRES_IN=8h

# ==========================================
# REDIS (Cache y WebSockets)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# FACTURACIÓN ELECTRÓNICA AFIP
# ==========================================
# Secreto para cifrado AES-256 de certificados y claves AFIP.
# ⚠️ Mínimo 32 caracteres aleatorios
AFIP_ENCRYPTION_SECRET=<AFIP_ENCRYPTION_SECRET_32_CHARS>

# ==========================================
# MERCADOPAGO (Pagos Online)
# ==========================================
# Credenciales de producción (comienzan con APP_USR-)
MP_ACCESS_TOKEN=<MP_PROD_ACCESS_TOKEN>
MP_PUBLIC_KEY=<MP_PROD_PUBLIC_KEY>

# ==========================================
# TRANSFERENCIAS BANCARIAS
# ==========================================
TRANSFER_ALIAS=tu.alias.aqui
TRANSFER_CBU=0000000000000000000000

# ==========================================
# CORREO (SMTP para notificaciones)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=<TU_APP_PASSWORD_SMTP>
MAIL_FROM="noreply@${DOMAIN}"

# ==========================================
# STORAGE AWS S3 (Opcional para logos/imágenes)
# ==========================================
S3_ACCESS_KEY=<S3_ACCESS_KEY>
S3_SECRET_KEY=<S3_SECRET_KEY>
S3_BUCKET=rms-assets
S3_REGION=us-east-1

# ==========================================
# FRONTEND (Vite - Variables de entorno públicas)
# ==========================================
# IMPORTANTE: Dejamos VITE_API_URL vacío en producción para que use rutas relativas /api
# Traefik se encarga del redireccionamiento interno
# VITE_API_URL=""
# VITE_WS_URL=""

# ==========================================
# CONFIGURACIÓN OAUTH MERCADOPAGO (PLATAFORMA)
# ==========================================
# Client ID y Secret de tu Aplicación en MercadoPago Developers
MP_CLIENT_ID=4644969659897356
MP_CLIENT_SECRET=6yaYLdtsDnYtVdpQi1U5jV3sN1Vo7DXC
MP_REDIRECT_URI=https://api.rms.dariassoft.com.ar/api/v1/settings/mercadopago/callback
APP_URL_FRONTEND=https://rms.dariassoft.com.ar
